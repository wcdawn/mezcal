[CORE]

mesh_file conduction_var_cond.mesh
boundary_conditions 0 0 0 1
userxs finite_cyl.xs

[MATERIAL]

name m1
MAT1 1.0
exact_area_volume -1.

name m2
MAT1 1.0
exact_area_volume -1.

[STATE]
solver conduction_var_cond

temp_boundary 300.
temp_heat_pipe 600.

temp_inner_rel 1e-12
temp_inner_abs 1e-12
temp_max_inner 1000
temp_tol 1e-8
