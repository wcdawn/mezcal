[CORE]

mesh_file conduction_linear.mesh
boundary_conditions 0 0 0 1
userxs 1.0 finite_cyl.xs

[MATERIAL]

name m1
MAT1 1.0
exact_area_volume -1.

name m2
MAT1 1.0
exact_area_volume -1.

[STATE]
solver conduction_linear

temp_boundary 300.
temp_heat_pipe 400.

temp_inner_rel 1e-12
temp_inner_abs 1e-12
temp_max_inner 1000
