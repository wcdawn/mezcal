# Makefile

CXXFLAGS = -Wall -pedantic-errors -std=$(STD) -fopenmp
# LDFLAGS = -std=$(STD) # -fopenmp # doesn't work with nvcc
LDFLAGS = -std=$(STD)

NVCC = nvcc

ifeq ($(MACH),SUMMIT)
STD = c++11
MPICXX = mpixlC
H5_DIR = $(OLCF_HDF5_ROOT)/lib

MPI_DIR = $(OLCF_SPECTRUM_MPI_ROOT)
MPI_LIB = -L$(MPI_DIR)/lib -lmpi_ibm

PROJ = /ccs/proj/csc254/wcdawn/container
MFEM_DIR = $(PROJ)/mfem
HYPRE_DIR = $(PROJ)/hypre/src/hypre
METIS_DIR = $(PROJ)/metis-5.1.0
METIS_LIB = -L$(METIS_DIR)/lib -lmetis

# CUDA_DIR is set automatically by the module
CUDA_ARCH = -arch=sm_70

PETSC_DIR = $(PROJ)/petsc/arch-olcf-summit-opt
SLEPC_DIR = $(PROJ)/slepc/arch-olcf-summit-opt

CXXFLAGS += -DGPU_AWARE_MPI
CXXFLAGS += -DAMGX_AVAILABLE

AMGX_DIR = $(OLCF_AMGX_ROOT)
AMGX_LIB_DIR = $(AMGX_DIR)/lib
AMGX_INCLUDE_DIR = $(AMGX_DIR)/include

else ifeq ($(MACH),ARCHBUILD)

STD = c++17
MPICXX = mpicxx
H5_DIR = /usr/lib

MPI_LIB = -L/usr/lib/openmpi -lmpi -lmpi_cxx

MICROREACTOR_DIR = /home/wcdawn/projects/container
MFEM_DIR = $(MICROREACTOR_DIR)/mfem
HYPRE_DIR = $(MICROREACTOR_DIR)/hypre/src/hypre
METIS_DIR = $(MICROREACTOR_DIR)/parmetis-4.0.3/metis

METIS_LIB = $(METIS_DIR)/../build/Linux-x86_64/libparmetis/libmetis.a

CUDA_DIR = /opt/cuda
PETSC_DIR = /home/wcdawn/projects/container/petsc/arch-linux-c-opt
SLEPC_DIR = /home/wcdawn/projects/container/slepc/arch-linux-c-opt
CUDA_ARCH = -arch=sm_75

CXXFLAGS += -DAMGX_AVAILABLE

AMGX_DIR = /home/wcdawn/projects/amgx
AMGX_LIB_DIR = $(AMGX_DIR)/build
AMGX_INCLUDE_DIR  = $(AMGX_DIR)/base/include

PUMI_DIR = /home/wcdawn/projects/container/core

else ifeq ($(MACH),LASSEN)

STD = c++11
MPICXX = mpicxx
H5_DIR = /usr/lib64

MPI_DIR = $(MPI_ROOT)
MPI_LIB = -L$(MPI_DIR)/lib -lmpi_ibm

WORKSPACE = /usr/workspace/dawn1/container_pumi
MFEM_DIR = $(WORKSPACE)/mfem
HYPRE_DIR = $(WORKSPACE)/hypre/src/hypre
METIS_DIR = $(WORKSPACE)/metis-5.1.0
METIS_LIB = -L$(METIS_DIR)/lib -lmetis

CUDA_DIR = $(CUDA_HOME)
CUDA_ARCH = -arch=sm_70

PETSC_DIR = $(WORKSPACE)/petsc/arch-llnl-lassen-opt
SLEPC_DIR = $(WORKSPACE)/slepc/arch-llnl-lassen-opt

CXXFLAGS += -DGPU_AWARE_MPI
CXXFLAGS += -DAMGX_AVAILABLE

AMGX_DIR = $(WORKSPACE)/amgx
AMGX_LIB_DIR = $(AMGX_DIR)/build
AMGX_INCLUDE_DIR = $(AMGX_DIR)/base/include

PUMI_DIR = $(WORKSPACE)/core

else

$(error Invalid MACH)

endif

ifeq ($(METHOD), dbg)
CXXFLAGS += -O0 -g
else
CXXFLAGS += -O3
endif

PUMI_INCLUDE = -I$(PUMI_DIR)/pumi \
			   -I$(PUMI_DIR)/apf \
			   -I$(PUMI_DIR)/can \
			   -I$(PUMI_DIR)/mds \
			   -I$(PUMI_DIR)/gmi \
			   -I$(PUMI_DIR)/pcu \
			   -I$(PUMI_DIR)/crv \
			   -I$(PUMI_DIR)/ma \
			   -I$(PUMI_DIR)/mth \
			   -I$(PUMI_DIR)/spr
PUMI_LIB = -L$(PUMI_DIR)/build/pumi -lpumi \
		   -L$(PUMI_DIR)/build/crv -lcrv \
		   -L$(PUMI_DIR)/build/ma -lma \
		   -L$(PUMI_DIR)/build/mds -lmds \
		   -L$(PUMI_DIR)/build/apf -lapf \
		   -L$(PUMI_DIR)/build/pcu -lpcu \
		   -L$(PUMI_DIR)/build/gmi -lgmi \
		   -L$(PUMI_DIR)/build/parma -lparma \
		   -L$(PUMI_DIR)/build/lion -llion \
		   -L$(PUMI_DIR)/build/mth -lmth \
		   -L$(PUMI_DIR)/build/apf_zoltan -lzoltan \
		   -L$(PUMI_DIR)/build/spr -lspr \
		   -L$(PUMI_DIR)/../zoltan/build/src -lzoltan \
		   -L$(PUMI_DIR)/../parmetis-4.0.3/build/Linux-x86_64/libparmetis -lparmetis -lmetis

MPICXXFLAGS = $(CXXFLAGS)

H5CXXFLAGS = $(CXXFLAGS)
# generated using "h5c++ -show"
H5_LIB = -L$(H5_DIR) -lhdf5_hl_cpp -lhdf5_cpp -lhdf5_hl -lhdf5 -L$(H5_DIR) -lz

LD = $(MPICXX) 

MFEM_INCLUDE = -I$(MFEM_DIR)
MFEM_HEADER = $(MFEM_DIR)/mfem.hpp
MFEM_LIB = $(MFEM_DIR)/libmfem.a

HYPRE_INCLUDE = -I$(HYPRE_DIR)/include
HYPRE_LIB = $(HYPRE_DIR)/lib/libHYPRE.a

METIS_INCLUDE = -I$(METIS_DIR)/include

CUDA_INCLUDE = -I$(CUDA_DIR)/include
CUDA_LIB = -L$(CUDA_DIR)/lib64 -lcudart -ldl -lrt -lcublas -lcusparse -lcusolver -lnvToolsExt -lcurand

PETSC_INCLUDE = -I$(PETSC_DIR)/include -I$(PETSC_DIR)/../include
PETSC_LIB = -L$(PETSC_DIR)/lib -l:libpetsc.so

SLEPC_INCLUDE = -I$(SLEPC_DIR)/include -I$(SLEPC_DIR)/../include
SLEPC_LIB = -L$(SLEPC_DIR)/lib -l:libslepc.so

AMGX_INCLUDE = -I$(AMGX_DIR)/base/include
AMGX_LIB = -L$(AMGX_DIR)/build -lamgx

MPI_INCLUDE = -I$(MPI_DIR)/include

INCLUDE = $(MFEM_INCLUDE) $(HYPRE_INCLUDE) $(METIS_INCLUDE) $(CUDA_INCLUDE) $(PETSC_INCLUDE) $(SLEPC_INCLUDE) $(AMGX_INCLUDE) $(PUMI_INCLUDE)
LIBS = $(MFEM_LIB) $(HYPRE_LIB) $(METIS_LIB) $(CUDA_LIB) $(H5_LIB) $(PETSC_LIB) $(SLEPC_LIB) $(AMGX_LIB) $(PUMI_LIB)
