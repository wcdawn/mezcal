# Makefile

CXXFLAGS = -Wall -pedantic-errors -std=$(STD) -fopenmp
LDFLAGS = -std=$(STD)

LD = nvcc

ifeq ($(MEZCAL_MACH),SUMMIT)
STD = c++11
MPICXX = mpixlC
H5_DIR = $(OLCF_HDF5_ROOT)/lib

MPI_DIR = $(OLCF_SPECTRUM_MPI_ROOT)
MPI_LIB = -L$(MPI_DIR)/lib -lmpi_ibm

PROJ = /ccs/proj/csc404/wcdawn/container
MFEM_DIR = $(PROJ)/mfem
HYPRE_DIR = $(PROJ)/hypre/src/hypre
METIS_DIR = $(PROJ)/metis-5.1.0
METIS_LIB = -L$(METIS_DIR)/build/Linux-ppc64le/libmetis -lmetis

PETSC_DIR = $(PROJ)/petsc/arch-olcf-summit-opt
PETSC_INCLUDE = -I$(PETSC_DIR)/include -I$(PETSC_DIR)/../include
PETSC_LIB = -L$(PETSC_DIR)/lib -l:libpetsc.so

SLEPC_DIR = $(PROJ)/slepc/arch-olcf-summit-opt
SLEPC_INCLUDE = -I$(SLEPC_DIR)/include -I$(SLEPC_DIR)/../include
SLEPC_LIB = -L$(SLEPC_DIR)/lib -l:libslepc.so

CXXFLAGS += -DGPU_AWARE_MPI
CXXFLAGS += -DPETSC_AVAILABLE

# CUDA_DIR is set automatically by the module
GPU_ARCH = -arch=sm_70
GPU_INCLUDE = -I$(CUDA_DIR)/include
GPU_LIB = -L$(CUDA_DIR)/lib64 -lcudart -ldl -lrt -lcublas -lcusparse -lcusolver -lnvToolsExt -lcurand

else ifeq ($(MEZCAL_MACH),CRUSHER)

STD = c++11
MPICXX = hipcc
LD = hipcc

H5_DIR = $(OLCF_HDF5_ROOT)/lib
H5_INCLUDE = -I$(OLCF_HDF5_ROOT)/include

# relies on MPICH_DIR and CRAY_MPICH_ROOTDIR set by cray-mpich module
MPI_DIR = $(MPICH_DIR)
MPI_LIB = -L$(MPICH_DIR)/lib -lmpi -L$(CRAY_MPICH_ROOTDIR)/gtl/lib -lmpi_gtl_hsa

METIS_LIB = $(METIS_DIR)/build/Linux-x86_64/libmetis/libmetis.a

CXXFLAGS += -DGPU_AWARE_MPI

CONTAINER = /ccs/proj/csc404/wcdawn/container_hip
MFEM_DIR = $(CONTAINER)/mfem
HYPRE_DIR = $(CONTAINER)/hypre-2.23.0/src/hypre
METIS_DIR = $(CONTAINER)/metis-5.1.0

GPU_ARCH = --amdgpu-target=gfx90a
GPU_LIB = -L/opt/rocm-4.5.0/lib -lrocsparse -lrocrand -lhipsparse

else ifeq ($(MEZCAL_MACH),ARCHBUILD)

STD = c++17
MPICXX = mpicxx
H5_DIR = /usr/lib

MPI_LIB = -L/usr/lib/openmpi -lmpi -lmpi_cxx

MICROREACTOR_DIR = /home/wcdawn/projects/container
MFEM_DIR = $(MICROREACTOR_DIR)/mfem
HYPRE_DIR = $(MICROREACTOR_DIR)/hypre/src/hypre
METIS_DIR = $(MICROREACTOR_DIR)/metis-5.1.0/

METIS_LIB = $(METIS_DIR)/build/Linux-x86_64/libmetis/libmetis.a

CUDA_DIR = /opt/cuda
GPU_ARCH = -arch=sm_75
GPU_INCLUDE = -I$(CUDA_DIR)/include
GPU_LIB = -L$(CUDA_DIR)/lib64 -lcudart -ldl -lrt -lcublas -lcusparse -lcusolver -lnvToolsExt -lcurand

PETSC_DIR = /home/wcdawn/projects/container/petsc/arch-linux-c-opt
PETSC_INCLUDE = -I$(PETSC_DIR)/include -I$(PETSC_DIR)/../include
PETSC_LIB = -L$(PETSC_DIR)/lib -l:libpetsc.so

SLEPC_DIR = /home/wcdawn/projects/container/slepc/arch-linux-c-opt
SLEPC_INCLUDE = -I$(SLEPC_DIR)/include -I$(SLEPC_DIR)/../include
SLEPC_LIB = -L$(SLEPC_DIR)/lib -l:libslepc.so

CXXFLAGS += -DAMGX_AVAILABLE
CXXFLAGS += -DPETSC_AVAILABLE
LDFLAGS += -Xcompiler -fopenmp -Xcompiler -pthread

AMGX_DIR = /home/wcdawn/projects/amgx
AMGX_LIB_DIR = $(AMGX_DIR)/build
AMGX_INCLUDE_DIR  = $(AMGX_DIR)/base/include

AMGX_INCLUDE = -I$(AMGX_DIR)/base/include
AMGX_LIB = -L$(AMGX_DIR)/build -lamgx

else ifeq ($(MEZCAL_MACH),ARCHBUILD_CPU)

CONTAINER=/home/wcdawn/projects/container_cpu
MPI_DIR=$(CONTAINER)/mpich-install

STD = c++17
MPICXX=$(MPI_DIR)/bin/mpicxx
H5_DIR=$(CONTAINER)/hdf5-1.12.1/hdf5/lib

MPI_LIB = -L$(MPI_DIR)/lib -lmpi -lmpicxx

MFEM_DIR=$(CONTAINER)/mfem
HYPRE_DIR=$(CONTAINER)/hypre-2.26.0/src/hypre
METIS_DIR=$(CONTAINER)/metis-5.1.0

METIS_LIB=$(METIS_DIR)/lib/libmetis.a

# TODO something about CUDA/GPU
LD=$(MPICXX)

PETSC_DIR=$(CONTAINER)/petsc-3.20.0
PETSC_ARCH=arch-linux-c-debug
PETSC_INCLUDE = -I$(PETSC_DIR)/include -I$(PETSC_DIR)/$(PETSC_ARCH)/include
PETSC_LIB = -Wl,-rpath,$(PETSC_DIR)/$(PETSC_ARCH)/lib -L$(PETSC_DIR)/$(PETSC_ARCH)/lib -lpetsc -lHYPRE -llapack -lblas -lgfortran -lX11

SLEPC_DIR=$(CONTAINER)/slepc-3.20.0
SLEPC_INCLUDE=-I$(SLEPC_DIR)/$(PETSC_ARCH)/include -I$(SLEPC_DIR)/include
SLEPC_LIB = -Wl,-rpath,/$(SLEPC_DIR)/$(PETSC_ARCH)/lib -L$(SLEPC_DIR)/$(PETSC_ARCH)/lib -lslepc
SLEPC_LIB += $(PETSC_LIB) # double count

CXXFLAGS += -DPETSC_AVAILABLE
LDFLAGS += -fopenmp -pthread

else ifeq ($(MEZCAL_MACH),LASSEN)

STD = c++11
MPICXX = mpicxx
H5_DIR = /usr/lib64

MPI_DIR = $(MPI_ROOT)
MPI_LIB = -L$(MPI_DIR)/lib -lmpi_ibm

WORKSPACE = /usr/workspace/dawn1/container_pumi
MFEM_DIR = $(WORKSPACE)/mfem
HYPRE_DIR = $(WORKSPACE)/hypre/src/hypre
METIS_DIR = $(WORKSPACE)/metis-5.1.0
METIS_LIB = -L$(METIS_DIR)/lib -lmetis

# CUDA_HOME is set automatically by the module
GPU_ARCH = -arch=sm_70
GPU_INCLUDE = -I$(CUDA_HOME)/include
GPU_LIB = -L$(CUDA_HOME)/lib64 -lcudart -ldl -lrt -lcublas -lcusparse -lcusolver -lnvToolsExt -lcurand

PETSC_DIR = $(WORKSPACE)/petsc/arch-llnl-lassen-opt
PETSC_INCLUDE = -I$(PETSC_DIR)/include -I$(PETSC_DIR)/../include
PETSC_LIB = -L$(PETSC_DIR)/lib -l:libpetsc.so

SLEPC_DIR = $(WORKSPACE)/slepc/arch-llnl-lassen-opt
SLEPC_INCLUDE = -I$(SLEPC_DIR)/include -I$(SLEPC_DIR)/../include
SLEPC_LIB = -L$(SLEPC_DIR)/lib -l:libslepc.so

CXXFLAGS += -DGPU_AWARE_MPI
CXXFLAGS += -DAMGX_AVAILABLE
CXXFLAGS += -DPETSC_AVAILABLE

AMGX_DIR = $(WORKSPACE)/amgx
AMGX_LIB_DIR = $(AMGX_DIR)/build
AMGX_INCLUDE_DIR = $(AMGX_DIR)/base/include

AMGX_INCLUDE = -I$(AMGX_DIR)/base/include
AMGX_LIB = -L$(AMGX_DIR)/build -lamgx

else ifeq ($(MEZCAL_MACH),JEZEBEL)

STD = c++17

H5_DIR = /usr/lib/x86_64-linux-gnu/hdf5/serial
H5_INCLUDE = -I$(H5_DIR)/include

MPI_DIR = /home/wcdawn/bin/openmpi-4.1.2/bin
MPICXX = $(MPI_DIR)/mpicxx
MPI_LIB = -L$(MPI_DIR)/lib -lmpi

CONTAINER = /home/wcdawn/projects/container
MFEM_DIR = $(CONTAINER)/mfem
HYPRE_DIR = $(CONTAINER)/hypre-2.23.0/src/hypre
METIS_DIR = $(CONTAINER)/metis-5.1.0

METIS_LIB = $(METIS_DIR)/build/Linux-x86_64/libmetis/libmetis.a

LD = $(MPICXX)

else ifeq ($(MEZCAL_MACH),IAGO)

CONTAINER=/users/william.dawn/projects/container

MPI_DIR=$(CONTAINER)/mpich-install
MFEM_DIR=$(CONTAINER)/mfem-4.5
HYPRE_DIR=$(CONTAINER)/hypre-2.26.0/src/hypre
METIS_DIR=$(CONTAINER)/metis-5.1.0

METIS_LIB=$(METIS_DIR)/lib/libmetis.a

STD = c++11
MPICXX=$(MPI_DIR)/bin/mpicxx
H5_DIR=/usr/lib64

MPI_LIB = -L$(MPI_DIR)/lib -Wl,-rpath,$(MPI_DIR)/lib -lmpi -lmpicxx -lmpifort -ldl -lrt -lm -lpthread -lquadmath

# TODO something about CUDA/GPU
LD=$(MPICXX)

PETSC_DIR=$(CONTAINER)/petsc-3.18.1
PETSC_ARCH=arch-linux-c-debug
PETSC_INCLUDE = -I$(PETSC_DIR)/include -I$(PETSC_DIR)/$(PETSC_ARCH)/include
PETSC_LIB = -Wl,-rpath,$(PETSC_DIR)/$(PETSC_ARCH)/lib -L$(PETSC_DIR)/$(PETSC_ARCH)/lib -lpetsc -lHYPRE -llapack -lblas -lgfortran -lX11

SLEPC_DIR=$(CONTAINER)/slepc-3.18.1
SLEPC_INCLUDE=-I$(SLEPC_DIR)/$(PETSC_ARCH)/include -I$(SLEPC_DIR)/include
SLEPC_LIB = -Wl,-rpath,/$(SLEPC_DIR)/$(PETSC_ARCH)/lib -L$(SLEPC_DIR)/$(PETSC_ARCH)/lib -lslepc
SLEPC_LIB += $(PETSC_LIB) # double count

CXXFLAGS += -DPETSC_AVAILABLE
LDFLAGS += -fopenmp -pthread

else

$(error Invalid MEZCAL_MACH)

endif

ifeq ($(METHOD), dbg)
CXXFLAGS += -O0 -g
else
CXXFLAGS += -O3
endif

MPICXXFLAGS = $(CXXFLAGS)

# generated using "h5c++ -show"
#H5_LIB = -L$(H5_DIR) -lhdf5_hl_cpp -lhdf5_cpp -lhdf5_hl -lhdf5 -L$(H5_DIR) -lz
H5_LIB = -L$(H5_DIR) -lhdf5_cpp -lhdf5

MFEM_INCLUDE = -I$(MFEM_DIR)
MFEM_HEADER = $(MFEM_DIR)/mfem.hpp
MFEM_LIB = $(MFEM_DIR)/libmfem.a

HYPRE_INCLUDE = -I$(HYPRE_DIR)/include
HYPRE_LIB = -L$(HYPRE_DIR)/lib -lHYPRE

METIS_INCLUDE = -I$(METIS_DIR)/include

MPI_INCLUDE = -I$(MPI_DIR)/include

INCLUDE = $(MFEM_INCLUDE) $(HYPRE_INCLUDE) $(METIS_INCLUDE) $(H5_INCLUDE) $(MPI_INCLUDE) $(PETSC_INCLUDE) $(SLEPC_INCLUDE) $(AMGX_INCLUDE) $(GPU_INCLUDE)
LIBS = $(MFEM_LIB) $(HYPRE_LIB) $(METIS_LIB) $(H5_LIB) $(MPI_LIB) $(PETSC_LIB) $(SLEPC_LIB) $(AMGX_LIB) $(GPU_LIB)
