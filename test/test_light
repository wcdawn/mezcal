    def test_valgrind_1d1g(self):
        input_file = os.path.join(self.dirname, "../analytic/1d1g/1d1g.inp")
        data = driver.run_code("valgrind", self.executable, "-i", input_file)

        definitely_lost = any("definitely lost: 0 bytes in 0 blocks" in s for s in data)
        self.assertTrue(definitely_lost)

        indirectly_lost = any("indirectly lost: 0 bytes in 0 blocks" in s for s in data)
        self.assertTrue(indirectly_lost)

        possibly_lost = any("possibly lost: 0 bytes in 0 blocks" in s for s in data)
        self.assertTrue(possibly_lost)

        error_check = any("ERROR SUMMARY: 0 errors from 0 contexts" in s for s in data)
        self.assertTrue(error_check)

