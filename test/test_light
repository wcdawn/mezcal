#!/bin/python3

import driver
import unittest
import os
import numpy as np

class Test_light(unittest.TestCase):

    dirname = os.path.dirname(__file__)
    executable = os.path.join(dirname, "../src/micro.x")

    k_tol   = 1e-6 # absolute tolerance
    err_tol = 1e-4 # absolute tolerance

    # tolerance is as input or sqrt(eps)
    def assert_relative_equal(self, a, b, *args, **kwargs):
        tol = kwargs.get('tol', np.sqrt(np.finfo(float).eps))
        return self.assertTrue((np.abs(a - b) / np.max([a, b])) <= tol)

    # tolerance is as input or sqrt(eps)
    def assert_absolute_equal(self, a, b, *args, **kwargs):
        tol = kwargs.get('tol', np.sqrt(np.finfo(float).eps))
        return self.assertTrue(np.abs(a - b)  <= tol)

    def test_1d1g_tri(self):
        input_file = os.path.join(self.dirname, "../analytic/1d1g/1d1g.inp")
        data = driver.run_code(self.executable, "-i", input_file)

        keff = driver.get_value(data, "keff")
        kref = 0.96505010141496050391
        self.assert_absolute_equal(keff, kref, tol=self.k_tol)

        rmsnorm = driver.get_value(data, "rmsnorm")
        rmsnorm_ref = 0.000109262
        self.assert_absolute_equal(rmsnorm, rmsnorm_ref, tol=self.err_tol)

        infnorm = driver.get_value(data, "infnorm")
        infnorm_ref = 0.000386792
        self.assert_absolute_equal(infnorm, infnorm_ref, tol=self.err_tol)

