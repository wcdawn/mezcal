
//  Hexagon Mesh Generator 

refinement=0;
refine_calc=0.5^refinement;

lc_base = 0.5;
lc_factor = 2;

// set characteristic length
lc=lc_base*refine_calc;    // we could use 0.4 here for better meshes
lcb=lc_factor*lc;  // characteristic length on border

//General.BackgroundGradient=0; 
//General.Color.Background={63,255,50};

Mesh.MshFileVersion = 2.2;

